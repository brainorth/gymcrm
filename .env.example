# ---------------------------------------------------------------------------
# Supabase (Postgres + Storage). Auth is OUR OWN — do NOT enable Supabase Auth.
# ---------------------------------------------------------------------------
# Runtime connection: Supabase POOLER (transaction mode, port 6543) — serverless safe.
#   Project Settings -> Database -> Connection string -> "Transaction pooler"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Migration / introspection connection: DIRECT (port 5432) or "Session pooler".
#   Migrations need a session-level connection (advisory locks, DDL).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Local development (this repo ships a docker-free local PG recipe in README):
# DATABASE_URL="postgresql://gym_app:gym_app@127.0.0.1:5432/gym_saas?sslmode=disable"
# DIRECT_URL="postgresql://gym_app:gym_app@127.0.0.1:5432/gym_saas?sslmode=disable"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Apex domain. Marketing lives here; the app lives on app.<APEX> (see docs/DECISIONS.md)
NEXT_PUBLIC_APEX_DOMAIN="brainorth.com"
NEXT_PUBLIC_APP_HOST="gym.brainorth.com"
# Set to "true" when running on localhost so /gym/... path fallback works without DNS
ENABLE_PATH_TENANT_FALLBACK="true"

# 32+ bytes of entropy. openssl rand -base64 48
# Used to HMAC session tokens at rest + sign QR attendance tokens.
AUTH_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef"
SESSION_COOKIE_NAME="gym_session"
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Storage (Supabase Storage buckets: member-photos, member-id-proofs, gym-logos)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key: server only, never NEXT_PUBLIC>"
STORAGE_DRIVER="supabase"            # supabase | local  (local = ./var/uploads, dev only)

# ---------------------------------------------------------------------------
# Razorpay — wired but inert until keys are present (see src/server/payments)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""           # platform account webhook
RAZORPAYX_ACCOUNT_NUMBER=""          # Route: source account for transfers
PAYMENTS_DRIVER="mock"               # mock | razorpay

# ---------------------------------------------------------------------------
# Notifications (outbox worker) — inert until configured
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
ALERTS_FROM_EMAIL="alerts@brainorth.com"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
CRON_SECRET=""                       # bearer token for /api/cron/* endpoints
